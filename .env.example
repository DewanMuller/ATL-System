# Copy this file to .env and fill in real values. Never commit .env itself.

# Local dev: a file path (e.g. "file:./dev.db").
# Production: a Turso/libSQL URL (e.g. "libsql://<db>-<org>.turso.io").
DATABASE_URL="file:./dev.db"

# Only required when DATABASE_URL is a remote libsql:// URL. Generate one
# per environment from the Turso dashboard (Database > Tokens). Leave unset
# for local file-based dev.
TURSO_AUTH_TOKEN=

# NextAuth session signing secret. Generate a separate one per environment,
# e.g.: openssl rand -base64 32
AUTH_SECRET=

# Error monitoring (Sentry). Set automatically in Vercel by the Sentry
# integration. Safe to leave unset for local dev — Sentry.init() no-ops
# without a dsn.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
